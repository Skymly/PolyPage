{
  "manifest_version": 3,
  "name": "PolyPage — Web Translator",
  "short_name": "PolyPage",
  "version": "4.2.0",
  "description": "Translate web pages, PDFs, images and video subtitles with your own LLM / DeepL / Azure / Google / local gateway. Bilingual reading, inline mode, hover tooltips, selection translate.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PolyPage — Web Translator",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["storage", "nativeMessaging", "contextMenus"],
  "optional_permissions": ["webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/*", "vendor/tessdata/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Translate current page / restore original"
    },
    "repeat-selection": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Repeat the last selection translation"
    }
  }
}