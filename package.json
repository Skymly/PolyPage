{
  "name": "polypage-web-translator",
  "displayName": "PolyPage — Web Translator Extension",
  "version": "4.2.1",
  "description": "Chrome/Edge Manifest V3 translator for web pages, PDFs, images and video subtitles with pluggable LLM / custom API providers, bilingual reading and hover tooltips.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/manifest-firefox.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-test.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:gateway",
    "test:gateway": "dotnet test native-host/PolyPage.slnx -v q",
    "test:contract": "node scripts/gateway-contract-test.mjs",
    "verify:all": "npm run verify && npm run test:contract && npm run smoke",
    "firefox:gateway": "node scripts/firefox-gateway-check.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "happy-dom": "^21.0.4",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "7.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
